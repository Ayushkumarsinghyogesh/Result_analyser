<div class="dashboard-container">
  <header class="main-header">
    <h1>Result Analyzer Dashboard</h1>
    <div class="job-actions">
      <%= button_to "Run Daily Job", run_daily_job_path, method: :post, class: "btn btn-secondary" %>
      <%= button_to "Run Monthly Job", run_monthly_job_path, method: :post, class: "btn btn-secondary" %>
    </div>
  </header>

  <div class="grid-layout">
    <section class="card form-card">
      <h2>Add Test Result</h2>
      <%= form_with url: submit_result_path, method: :post, local: true, class: "modern-form" do |f| %>
        <div class="form-group">
          <%= f.text_field :student_name, placeholder: "Student Name", required: true %>
        </div>
        <div class="form-group">
          <%= f.text_field :subject, placeholder: "Subject", required: true %>
        </div>
        <div class="form-group">
          <%= f.number_field :marks, placeholder: "Marks", required: true %>
        </div>
        <div class="form-group">
          <%= f.datetime_local_field :timestamp, required: true %>
        </div>
        <%= f.submit "Submit Result", class: "btn btn-primary" %>
      <% end %>
    </section>

    <div class="stats-column">
      <section class="card table-card">
        <h2>Daily Statistics</h2>
        <div class="table-responsive">
          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Subject</th>
                <th>Low</th>
                <th>High</th>
                <th>Count</th>
              </tr>
            </thead>
            <tbody>
              <% @daily_stats.each do |stat| %>
                <tr>
                  <td><%= stat.date %></td>
                  <td><span class="badge"><%= stat.subject %></span></td>
                  <td class="text-low"><%= stat.daily_low %></td>
                  <td class="text-high"><%= stat.daily_high %></td>
                  <td><strong><%= stat.result_count %></strong></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="card table-card">
        <h2>Monthly Statistics</h2>
        <div class="table-responsive">
          <table>
            <thead>
              <tr>
                <th>Month</th>
                <th>Subject</th>
                <th>Avg Low</th>
                <th>Avg High</th>
                <th>Total Count</th>
              </tr>
            </thead>
            <tbody>
              <% @monthly_stats.each do |stat| %>
                <tr>
                  <td><%= stat.month %></td>
                  <td><span class="badge"><%= stat.subject %></span></td>
                  <td><%= stat.avg_low %></td>
                  <td><%= stat.avg_high %></td>
                  <td><strong><%= stat.result_count %></strong></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
</div>